graph TB
    subgraph Users
        Dev[Developer]
        Admin[Admin]
    end

    subgraph System["Prompt Manager"]
        UI[SvelteKit UI<br/>Settings · Prompts · Testing]
        API[SvelteKit Server Routes<br/>REST API + SSE]
        Svc[Service Layer<br/>Business Logic]
        DB[(SQLite / libsql<br/>Drizzle ORM)]
    end

    subgraph External
        OC[OpenCode Server<br/>@opencode-ai/sdk]
        Auth[Better Auth<br/>Sessions + JWT]
    end

    Dev --> UI
    Admin --> UI
    UI --> API
    API --> Svc
    Svc --> DB
    Svc --> OC
    API --> Auth
    Auth --> DB

    classDef user fill:#e1f5fe,stroke:#0288d1,color:#01579b
    classDef system fill:#fff3e0,stroke:#ef6c00,color:#e65100
    classDef external fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20

    class Dev,Admin user
    class UI,API,Svc,DB system
    class OC,Auth external
