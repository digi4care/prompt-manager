import { afterAll, beforeAll, describe, expect, it } from 'vitest';
import { auth } from '$lib/auth';
import { db } from '$lib/server/db/client';
import { authAccounts, authUsers } from '$lib/server/db/schema';
import { eq } from 'drizzle-orm';

const testEmail = `test-${Date.now()}@example.com`;
const testPassword = 'password-123!';

const cleanupTestUser = async () => {
	await db.delete(authAccounts).where(eq(authAccounts.accountId, testEmail));
	await db.delete(authUsers).where(eq(authUsers.email, testEmail));
};

describe.skip('Better Auth Integration', () => {
	beforeAll(async () => {
		await cleanupTestUser();
	});

	afterAll(async () => {
		await cleanupTestUser();
	});

	it('should sign up and sign in with email/password', async () => {
		const signUp = await auth.api.signUpEmail({
			body: {
				email: testEmail,
				password: testPassword,
				name: 'Test User'
			}
		});

		expect(signUp?.user?.email).toBe(testEmail);

		const signIn = await auth.api.signInEmail({
			body: {
				email: testEmail,
				password: testPassword
			}
		});

		expect(signIn?.user?.email).toBe(testEmail);
	});
});
