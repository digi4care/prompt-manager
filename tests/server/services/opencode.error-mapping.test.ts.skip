// @ts-nocheck
import { describe, it, expect, vi, beforeEach } from 'vitest';
import {
	checkOpencodeHealth,
	executeAgent,
	OpenCodeError,
	OpenCodeConnectionError,
	OpenCodeAuthenticationError,
	OpenCodeValidationError,
	OpenCodeExecutionError,
	createOpenCodeService
} from '$lib/server/services/opencode.service';

// Mock the client
vi.mock('$lib/server/opencode/client', () => ({
	getOpencodeClient: vi.fn()
}));

describe.skip('OpenCode Service - Error Mapping', () => {
	beforeEach(() => {
		vi.clearAllMocks();
	});

	describe('Connection Errors', () => {
		it('maps ECONNREFUSED to OpenCodeConnectionError', async () => {
			const { getOpencodeClient } = await import('$lib/server/opencode/client');
			(getOpencodeClient as any).mockReturnValue({
				agent: {
					execute: vi.fn().mockRejectedValue(new Error('ECONNREFUSED'))
				}
			});

			await expect(executeAgent('test-agent', {})).rejects.toThrow(OpenCodeConnectionError);
		});

		it('maps ENOTFOUND to OpenCodeConnectionError', async () => {
			const { getOpencodeClient } = await import('$lib/server/opencode/client');
			(getOpencodeClient as any).mockReturnValue({
				agent: {
					execute: vi.fn().mockRejectedValue(new Error('ENOTFOUND'))
				}
			});

			await expect(executeAgent('test-agent', {})).rejects.toThrow(OpenCodeConnectionError);
		});

		it('maps EHOSTUNREACH to OpenCodeConnectionError', async () => {
			const { getOpencodeClient } = await import('$lib/server/opencode/client');
			(getOpencodeClient as any).mockReturnValue({
				agent: {
					execute: vi.fn().mockRejectedValue(new Error('EHOSTUNREACH'))
				}
			});

			await expect(executeAgent('test-agent', {})).rejects.toThrow(OpenCodeConnectionError);
		});

		it('maps "fetch failed" to OpenCodeConnectionError', async () => {
			const { getOpencodeClient } = await import('$lib/server/opencode/client');
			(getOpencodeClient as any).mockReturnValue({
				agent: {
					execute: vi.fn().mockRejectedValue(new Error('fetch failed'))
				}
			});

			await expect(executeAgent('test-agent', {})).rejects.toThrow(OpenCodeConnectionError);
		});
	});

	describe('Authentication Errors', () => {
		it('maps 401 to OpenCodeAuthenticationError', async () => {
			const { getOpencodeClient } = await import('$lib/server/opencode/client');
			(getOpencodeClient as any).mockReturnValue({
				agent: {
					execute: vi.fn().mockRejectedValue(new Error('401 Unauthorized'))
				}
			});

			await expect(executeAgent('test-agent', {})).rejects.toThrow(OpenCodeAuthenticationError);
		});

		it('maps 403 to OpenCodeAuthenticationError', async () => {
			const { getOpencodeClient } = await import('$lib/server/opencode/client');
			(getOpencodeClient as any).mockReturnValue({
				agent: {
					execute: vi.fn().mockRejectedValue(new Error('403 Forbidden'))
				}
			});

			await expect(executeAgent('test-agent', {})).rejects.toThrow(OpenCodeAuthenticationError);
		});

		it('maps "unauthorized" to OpenCodeAuthenticationError', async () => {
			const { getOpencodeClient } = await import('$lib/server/opencode/client');
			(getOpencodeClient as any).mockReturnValue({
				agent: {
					execute: vi.fn().mockRejectedValue(new Error('unauthorized'))
				}
			});

			await expect(executeAgent('test-agent', {})).rejects.toThrow(OpenCodeAuthenticationError);
		});
	});

	describe('Validation Errors', () => {
		it('maps 400 to OpenCodeValidationError', async () => {
			const { getOpencodeClient } = await import('$lib/server/opencode/client');
			(getOpencodeClient as any).mockReturnValue({
				agent: {
					execute: vi.fn().mockRejectedValue(new Error('400 Bad Request'))
				}
			});

			await expect(executeAgent('test-agent', {})).rejects.toThrow(OpenCodeValidationError);
		});

		it('maps "validation" to OpenCodeValidationError', async () => {
			const { getOpencodeClient } = await import('$lib/server/opencode/client');
			(getOpencodeClient as any).mockReturnValue({
				agent: {
					execute: vi.fn().mockRejectedValue(new Error('validation failed'))
				}
			});

			await expect(executeAgent('test-agent', {})).rejects.toThrow(OpenCodeValidationError);
		});
	});

	describe('Rate Limiting', () => {
		it('maps 429 to OpenCodeExecutionError with rate limit message', async () => {
			const { getOpencodeClient } = await import('$lib/server/opencode/client');
			(getOpencodeClient as any).mockReturnValue({
				agent: {
					execute: vi.fn().mockRejectedValue(new Error('429 Too Many Requests'))
				}
			});

			await expect(executeAgent('test-agent', {})).rejects.toThrow(OpenCodeExecutionError);
			try {
				await executeAgent('test-agent', {});
			} catch (err) {
				if (err instanceof OpenCodeExecutionError) {
					expect(err.message).toContain('Too many requests');
				}
			}
		});
	});

	describe('Server Errors', () => {
		it('maps 500 to OpenCodeExecutionError', async () => {
			const { getOpencodeClient } = await import('$lib/server/opencode/client');
			(getOpencodeClient as any).mockReturnValue({
				agent: {
					execute: vi.fn().mockRejectedValue(new Error('500 Internal Server Error'))
				}
			});

			await expect(executeAgent('test-agent', {})).rejects.toThrow(OpenCodeExecutionError);
		});

		it('maps 503 to OpenCodeExecutionError', async () => {
			const { getOpencodeClient } = await import('$lib/server/opencode/client');
			(getOpencodeClient as any).mockReturnValue({
				agent: {
					execute: vi.fn().mockRejectedValue(new Error('503 Service Unavailable'))
				}
			});

			await expect(executeAgent('test-agent', {})).rejects.toThrow(OpenCodeExecutionError);
		});

		it('maps "server error" to OpenCodeExecutionError', async () => {
			const { getOpencodeClient } = await import('$lib/server/opencode/client');
			(getOpencodeClient as any).mockReturnValue({
				agent: {
					execute: vi.fn().mockRejectedValue(new Error('server error'))
				}
			});

			await expect(executeAgent('test-agent', {})).rejects.toThrow(OpenCodeExecutionError);
		});
	});

	describe('Generic Errors', () => {
		it('wraps unknown errors in OpenCodeExecutionError', async () => {
			const { getOpencodeClient } = await import('$lib/server/opencode/client');
			(getOpencodeClient as any).mockReturnValue({
				agent: {
					execute: vi.fn().mockRejectedValue(new Error('Unknown error'))
				}
			});

			await expect(executeAgent('test-agent', {})).rejects.toThrow(OpenCodeExecutionError);
		});

		it('wraps non-Error values in OpenCodeExecutionError', async () => {
			const { getOpencodeClient } = await import('$lib/server/opencode/client');
			(getOpencodeClient as any).mockReturnValue({
				agent: {
					execute: vi.fn().mockRejectedValue('String error')
				}
			});

			await expect(executeAgent('test-agent', {})).rejects.toThrow(OpenCodeExecutionError);
		});

		it('re-throws already mapped OpenCodeError instances', async () => {
			const { getOpencodeClient } = await import('$lib/server/opencode/client');
			const originalError = new OpenCodeConnectionError('Original error');
			(getOpencodeClient as any).mockReturnValue({
				agent: {
					execute: vi.fn().mockRejectedValue(originalError)
				}
			});

			await expect(executeAgent('test-agent', {})).rejects.toBe(originalError);
		});
	});

	describe('Error Properties', () => {
		it('preserves error code', async () => {
			const { getOpencodeClient } = await import('$lib/server/opencode/client');
			(getOpencodeClient as any).mockReturnValue({
				agent: {
					execute: vi.fn().mockRejectedValue(new Error('401 Unauthorized'))
				}
			});

			try {
				await executeAgent('test-agent', {});
			} catch (err) {
				expect(err).toBeInstanceOf(OpenCodeError);
				expect((err as OpenCodeError).code).toBe('AUTHENTICATION_ERROR');
			}
		});

		it('preserves original error', async () => {
			const { getOpencodeClient } = await import('$lib/server/opencode/client');
			const originalError = new Error('Original message');
			(getOpencodeClient as any).mockReturnValue({
				agent: {
					execute: vi.fn().mockRejectedValue(originalError)
				}
			});

			try {
				await executeAgent('test-agent', {});
			} catch (err) {
				expect(err).toBeInstanceOf(OpenCodeError);
				expect((err as OpenCodeError).originalError).toBe(originalError);
			}
		});

		it('has correct error name', async () => {
			const { getOpencodeClient } = await import('$lib/server/opencode/client');
			(getOpencodeClient as any).mockReturnValue({
				agent: {
					execute: vi.fn().mockRejectedValue(new Error('401'))
				}
			});

			try {
				await executeAgent('test-agent', {});
			} catch (err) {
				expect(err).toBeInstanceOf(OpenCodeAuthenticationError);
				expect(err.name).toBe('OpenCodeAuthenticationError');
			}
		});
	});
});

describe('OpenCode Service - Dependency Injection', () => {
	it('creates service with injected client', async () => {
		const mockClient = {
			agent: {
				execute: vi.fn().mockResolvedValue({ result: 'success' })
			},
			global: {
				health: vi.fn().mockResolvedValue({ data: { version: '1.2.3' } })
			}
		} as any;

		const service = createOpenCodeService(mockClient);

		expect(service.client).toBe(mockClient);
		expect(typeof service.executeAgent).toBe('function');
		expect(typeof service.checkHealth).toBe('function');
	});

	it('service methods work with injected client', async () => {
		const mockClient = {
			agent: {
				execute: vi.fn().mockResolvedValue({ result: 'success' })
			}
		} as any;

		const service = createOpenCodeService(mockClient);

		const result = await service.executeAgent('test-agent', { input: 'data' });

		expect(mockClient.agent.execute).toHaveBeenCalledWith({
			agent: 'test-agent',
			input: { input: 'data' }
		});
		expect(result).toEqual({ result: 'success' });
	});
});
