{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "bash": {
            "rm *": "ask",
            "rm -rf *": "ask",
            "rmdir *": "ask",
            "rm -r *": "ask",
            "date *": "allow",
            "echo *": "allow",
            "cat *": "allow",
            "find *": "allow",
            "ls *": "allow",
            "mkdir *": "allow",
            "wc *": "allow",
            "head *": "allow",
            "tail *": "allow",
            "sort *": "allow",
            "grep *": "allow",
            "tr *": "allow",
            "git add *": "allow",
            "git commit *": "allow",
            "git status *": "allow",
            "git log *": "allow",
            "git diff *": "allow",
            "git tag *": "allow"
        }
    }
}