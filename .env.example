# Database (SQLite via Drizzle)
DATABASE_URL=file:local.db

# Better Auth Configuration
# Secret for session token encryption (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-secret-key-min-32-chars-here
# Base URL of your application (required in production)
BETTER_AUTH_URL=http://localhost:5173
# Optional: Base path for auth API (defaults to /api/auth)
# BETTER_AUTH_BASE_PATH=/api/auth

# OAuth Providers (auto-detected by Better Auth)
# GitHub OAuth (optional, for social login)
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret

# Google OAuth (optional, for social login)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Anthropic API (LLM-as-Judge)
ANTHROPIC_API_KEY=

# OpenCode Configuration
# OpenCode service URL for AI agent execution
# Required in production, optional in development (defaults to http://localhost:4096)
# In production with Docker: use the service name (e.g., http://opencode:4096)
# In development: use http://localhost:4096 or your running OpenCode instance
OPENCODE_URL=http://localhost:4096

# OpenCode Docker Configuration (optional)
# Only needed when running OpenCode in Docker
# OPENCODE_API_KEY=your-opencode-api-key
# OPENCODE_WS_URL=ws://opencode:4096 (if WebSocket is needed)

# Admin Authentication
# Required in ALL environments - development does not disable authentication
# Set a strong password for admin access
ADMIN_PASSWORD=
ADMIN_EMAIL=

# App Configuration
PUBLIC_APP_NAME=Prompt Wallet
PUBLIC_APP_URL=http://localhost:5173
# Security Configuration
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

NODE_ENV=development

# Docker Configuration
# Only needed when running with Docker Compose
# WEB_PORT=3000 (default port for web service)
# WEB_PORT=3000
