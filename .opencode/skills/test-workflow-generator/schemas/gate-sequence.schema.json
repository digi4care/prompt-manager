{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "GateSequence",
	"type": "object",
	"required": ["phase", "requiredArtifacts", "gate"],
	"properties": {
		"phase": {
			"type": "string",
			"pattern": "^P[0-9]{1,2}$"
		},
		"requiredArtifacts": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"minItems": 1
		},
		"gate": {
			"type": "string",
			"minLength": 1
		},
		"status": {
			"type": "string",
			"enum": ["pending", "passed", "failed"]
		}
	}
}
