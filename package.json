		"jsonwebtoken": "^9.0.3",
		"lucide-svelte": "^0.575.0",
		"marked": "^17.0.3",
		"monaco-editor": "^0.55.1",
		"qrcode": "^1.5.4",
		"runed": "^0.37.1",
