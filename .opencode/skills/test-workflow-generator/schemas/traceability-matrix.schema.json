{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "TraceabilityMatrixRow",
	"type": "object",
	"required": ["traceId", "rule", "area", "testIds", "targetFiles", "status"],
	"properties": {
		"traceId": {
			"type": "string",
			"pattern": "^TRACE-[A-Z0-9]+-[0-9]{3}$"
		},
		"rule": {
			"type": "string",
			"minLength": 1
		},
		"area": {
			"type": "string",
			"minLength": 1
		},
		"testIds": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^SET-[A-Z0-9]+-[0-9]{3}$"
			},
			"minItems": 1
		},
		"targetFiles": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"minItems": 1
		},
		"status": {
			"type": "string",
			"enum": ["Planned", "Partial", "Covered", "Blocked"]
		}
	}
}
